# ==============================================================================
# TUX: ROOT PURGE - AI DIRECTOR ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and insert your Google Gemini API key to enable
# dynamic in-game narrative, boss taunts, tactical John Helldiver comms, and
# dynamic enemy generation powered by Google Gemini.
#
# NOTE: This is 100% NON-MANDATORY. When omitted, the game runs smoothly with
# the built-in autonomous procedural director.
# ==============================================================================

# Your Google Gemini API Key (Get one at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Selected Gemini Model:
# Recommended: gemini-2.0-flash (Ultra fast, Google standard GA model)
# Alternatives:
#   gemini-1.5-flash (Standard production, high quota limits)
#   gemini-2.0-flash-lite (Lowest latency, economical)
#   gemini-1.5-pro (Deep narrative reasoning & complex lore)
#   gemini-2.5-flash (Preview)
#   gemini-2.5-pro (Preview)
GEMINI_MODEL=gemini-2.0-flash

# High Command Persona:
# Options: "JOHN_HELLDIVER" | "LINUS_TORVALDS" | "CORPORATE_NEMESIS"
AI_DIRECTOR_PERSONA=JOHN_HELLDIVER
